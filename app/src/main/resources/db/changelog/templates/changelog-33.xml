<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">

    <changeSet id="33-create-subscription-payment" author="easycourse">
        <comment>PRO subscription payments via YooKassa</comment>
        <createTable tableName="subscription_payment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="yookassa_payment_id" type="VARCHAR(36)">
                <constraints nullable="true" unique="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="subscription_payment" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_subscription_payment_user"/>
    </changeSet>

    <changeSet id="33-add-users-pro-until" author="easycourse">
        <comment>PRO subscription expiry date (NULL = unlimited)</comment>
        <addColumn tableName="users">
            <column name="pro_until" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
