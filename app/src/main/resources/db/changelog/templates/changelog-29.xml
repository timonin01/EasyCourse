<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">

    <changeSet id="29-ai-session-chat-type-varchar" author="easycourse">
        <comment>
            Keep chat_type extensible. Hibernate's MariaDB enum mapping previously
            restricted the column to CHAT and GENERATE, rejecting COURSE_AGENT.
        </comment>
        <modifyDataType
                tableName="ai_session"
                columnName="chat_type"
                newDataType="VARCHAR(20)"/>
    </changeSet>

</databaseChangeLog>
